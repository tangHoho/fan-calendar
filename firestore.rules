rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 帳號對應的頭像（讓 Google 登入換裝置也記得你是誰）：只能讀寫自己的
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.memberId is string
        && request.resource.data.memberId.size() <= 40;
    }

    // 成員頭像：表情 / 插畫 / 文字 / 照片（照片為縮小後的 JPEG，上限約 55KB）
    match /members/{id} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 12
        && request.resource.data.color is string
        && request.resource.data.get('kind', 'emoji') in ['emoji', 'art', 'text', 'photo']
        && (!('text' in request.resource.data) || (request.resource.data.text is string && request.resource.data.text.size() <= 4))
        && (!('photo' in request.resource.data) || (request.resource.data.photo is string
              && request.resource.data.photo.size() <= 60000
              && request.resource.data.photo.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')));
      allow delete: if false;
    }

    // 活動
    match /events/{id} {
      allow read, delete: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 60
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.note.size() <= 400
        && request.resource.data.get('saleDate', '').matches('^([0-9]{4}-[0-9]{2}-[0-9]{2})?$')
        && request.resource.data.get('saleTime', '').matches('^([01][0-9]|2[0-3]):[0-5][0-9]$|^$')
        && request.resource.data.get('saleUrl', '') is string
        && request.resource.data.get('saleUrl', '').size() <= 300
        && request.resource.data.get('saleUrl', '').matches('^(https?://.*)?$');
    }

    // 參加紀錄：文件 ID 必須是「活動ID__成員ID」
    match /rsvps/{id} {
      allow read, delete: if request.auth != null;
      allow create, update: if request.auth != null
        && id == request.resource.data.eventId + '__' + request.resource.data.memberId
        && exists(/databases/$(database)/documents/events/$(request.resource.data.eventId))
        && exists(/databases/$(database)/documents/members/$(request.resource.data.memberId));
    }
  }
}
